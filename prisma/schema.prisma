model ApprovalRequest {
  id                String    @id @default(cuid())
  issueId           String
  transitionId      String?
  requestedById     String
  status            String    @default("pending")
  fromStateId       String?
  toStateId         String?
  requiredApprovals Int       @default(1)
  approverUserIds   Json      @default("[]")
  reason            String?
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  issue       Issue              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  transition  StateTransition?   @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  requestedBy User               @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  fromState   State?             @relation("ApprovalRequestFromState", fields: [fromStateId], references: [id], onDelete: SetNull)
  toState     State?             @relation("ApprovalRequestToState", fields: [toStateId], references: [id], onDelete: SetNull)
  decisions   ApprovalDecision[]

  @@index([issueId, status])
  @@index([fromStateId])
  @@index([toStateId])
}

model ApprovalDecision {
  id         String   @id @default(cuid())
  requestId  String
  approverId String
