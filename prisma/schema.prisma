generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatar       String?
  passwordHash String?
  isActive     Boolean  @default(true)
  deactivatedAt DateTime?
  mustResetPassword Boolean @default(false)
  failedLoginAttempts Int @default(0)
  lockoutUntil DateTime?
  mfaSecret    String?
  mfaEnabled   Boolean  @default(false)
  mfaEnabledAt DateTime?
  mfaExemptFromPolicy Boolean @default(false)
  mfaReenrollRequired Boolean @default(false)
  globalRole   String   @default("member")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedIssues     Issue[]           @relation("AssignedIssues")
  reportedIssues     Issue[]           @relation("ReportedIssues")
  comments           Comment[]
  commentMentions    CommentMention[]
  commentRevisions   CommentRevision[] @relation("CommentRevisionEditor")
  activities         Activity[]
  projectMemberships ProjectMember[]
  attachments        Attachment[]
  sprintCapacities   SprintCapacity[]
  teamMemberships    TeamMember[]
  ledTeams           Team[]            @relation("TeamLead")
  createdTeams       Team[]            @relation("TeamCreator")
  authSessions       AuthSession[]
  securityAuditEventsAuthored SecurityAuditEvent[] @relation("SecurityAuditActor")
  securityAuditEventsTargeted SecurityAuditEvent[] @relation("SecurityAuditTarget")
}

model AuthSession {
  id                String   @id @default(cuid())
  userId            String
  userAgent         String?
  ipAddress         String?
  deviceLabel       String?
  mfaVerifiedAt     DateTime?
  mfaBypassed       Boolean  @default(false)
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model SecurityAuditEvent {
  id           String   @id @default(cuid())
  actorUserId  String?
  targetUserId String?
  action       String
  details      Json?
  createdAt    DateTime @default(now())

  actorUser  User? @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("SecurityAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model SprintCapacity {
  id            String   @id @default(cuid())
  iterationId   String
  userId        String
  hoursPerDay   Float    @default(8)
  daysOff       Int      @default(0)
  totalCapacity Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  iteration Iteration @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([iterationId, userId])
  @@index([iterationId])
  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  color       String   @default("#6366f1")
  icon        String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issues         Issue[]
  members        ProjectMember[]
  labels         Label[]
  iterations     Iteration[]
  activities     Activity[]
  states         State[]
  areas          Area[]
  teams          Team[]
  workItemTypes  WorkItemTypeDefinition[]
  workItemFields WorkItemFieldDefinition[]
  workItemValues WorkItemFieldValue[]
  workItemSections WorkItemSectionDefinition[]
  workItemTypeStateMappings WorkItemTypeStateMapping[]
  workItemTypeFieldMappings WorkItemTypeFieldMapping[]
  stateTransitions StateTransition[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("Dev")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Team {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  key         String?
  description String?
  color       String   @default("#0f766e")
  leadId      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lead      User?       @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("TeamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   TeamMember[]
  iterations Iteration[]

  @@unique([projectId, name])
  @@unique([projectId, key])
  @@index([projectId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model State {
  id        String @id @default(cuid())
  projectId String
  name      String
  color     String
  category  String
  order     Int    @default(0)
  isFinal   Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]
  workItemTypeMappings WorkItemTypeStateMapping[]
  outgoingTransitions  StateTransition[] @relation("StateTransitionFrom")
  incomingTransitions  StateTransition[] @relation("StateTransitionTo")

  @@unique([projectId, name])
  @@index([projectId, order])
}

model Area {
  id        String  @id @default(cuid())
  projectId String
  name      String
  path      String?
  pathSegments Json?
  parentId  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent  Area?   @relation("AreaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Area[] @relation("AreaHierarchy")
  issues   Issue[]

  @@unique([projectId, path])
  @@index([projectId])
  @@index([parentId])
  @@index([projectId, parentId])
}

model Iteration {
  id            String      @id @default(cuid())
  projectId     String
  teamId        String?
  name          String
  path          String?
  pathSegments  Json?
  goal          String?
  startDate     DateTime?
  endDate       DateTime?
  status        String      @default("Planned")
  iterationType String      @default("sprint")
  parentId      String?

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent           Iteration?       @relation("IterationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Iteration[]      @relation("IterationHierarchy")
  issues           Issue[]
  sprintCapacities SprintCapacity[]

  @@unique([projectId, path])
  @@unique([projectId, teamId, name])
  @@index([projectId])
  @@index([teamId])
  @@index([parentId])
  @@index([projectId, status])
}

model WorkItemTypeDefinition {
  id             String   @id @default(cuid())
  projectId      String
  key            String
  name           String
  description    String?
  icon           String?
  color          String   @default("#64748b")
  hierarchyLevel Int      @default(4)
  isSystem       Boolean  @default(false)
  isEnabled      Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project  Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues   Issue[]
  sections WorkItemSectionDefinition[]
  fields   WorkItemFieldDefinition[]
  fieldMappings WorkItemTypeFieldMapping[]
  stateMappings WorkItemTypeStateMapping[]
  stateTransitions StateTransition[]

  @@unique([projectId, key])
  @@index([projectId, order])
}

model WorkItemSectionDefinition {
  id             String   @id @default(cuid())
  projectId      String
  workItemTypeId String
  key            String
  title          String
  description    String?
  sectionType    String   @default("fields")
  order          Int      @default(0)
  isSystem       Boolean  @default(false)
  isCollapsible  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItemType WorkItemTypeDefinition @relation(fields: [workItemTypeId], references: [id], onDelete: Cascade)
  fields       WorkItemFieldDefinition[]
  fieldMappings WorkItemTypeFieldMapping[]

  @@unique([workItemTypeId, key])
  @@index([workItemTypeId, order])
}

model WorkItemFieldDefinition {
  id             String   @id @default(cuid())
  projectId      String
  workItemTypeId String
  sectionId      String?
  key            String
  label          String
  description    String?
  dataType       String
  required       Boolean  @default(false)
  isSystem       Boolean  @default(false)
  isQueryable    Boolean  @default(true)
  placeholder    String?
  defaultValue   Json?
  options        Json?
  config         Json?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItemType WorkItemTypeDefinition      @relation(fields: [workItemTypeId], references: [id], onDelete: Cascade)
  section      WorkItemSectionDefinition?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  values       WorkItemFieldValue[]
  typeMappings WorkItemTypeFieldMapping[]

  @@unique([workItemTypeId, key])
  @@index([workItemTypeId, order])
  @@index([projectId, key])
}

model WorkItemTypeStateMapping {
  id             String   @id @default(cuid())
  projectId      String
  workItemTypeId String
  stateId        String
  order          Int      @default(0)
  isInitial      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItemType WorkItemTypeDefinition @relation(fields: [workItemTypeId], references: [id], onDelete: Cascade)
  state        State                  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([workItemTypeId, stateId])
  @@index([projectId, workItemTypeId, order])
  @@index([stateId])
}

model StateTransition {
  id             String   @id @default(cuid())
  projectId      String
  workItemTypeId String
  fromStateId    String
  toStateId      String
  order          Int      @default(0)
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItemType WorkItemTypeDefinition @relation(fields: [workItemTypeId], references: [id], onDelete: Cascade)
  fromState    State                  @relation("StateTransitionFrom", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState      State                  @relation("StateTransitionTo", fields: [toStateId], references: [id], onDelete: Cascade)

  @@unique([workItemTypeId, fromStateId, toStateId])
  @@index([projectId, workItemTypeId, fromStateId, order])
  @@index([toStateId])
}

model WorkItemTypeFieldMapping {
  id                String   @id @default(cuid())
  projectId         String
  workItemTypeId    String
  fieldDefinitionId String
  sectionId         String?
  groupKey          String   @default("details")
  order             Int      @default(0)
  requiredOverride  Boolean?
  isVisible         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItemType    WorkItemTypeDefinition    @relation(fields: [workItemTypeId], references: [id], onDelete: Cascade)
  fieldDefinition WorkItemFieldDefinition   @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  section         WorkItemSectionDefinition? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([workItemTypeId, fieldDefinitionId])
  @@index([projectId, workItemTypeId, groupKey, order])
  @@index([fieldDefinitionId])
}

model Issue {
  id                 String   @id @default(cuid())
  projectId          String
  key                String
  title              String
  description        String?
  workItemType       String   @default("task")
  status             String   @default("backlog")
  priority           String   @default("medium")
  severity           String?
  storyPoints        Int?
  estimatedHours     Float?
  remainingHours     Float?
  completedHours     Float?
  dueDate            DateTime?
  startDate          DateTime?
  completedDate      DateTime?
  columnOrder        Float    @default(0)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  assigneeId         String?
  reporterId         String
  iterationId        String?
  areaId             String?
  stateId            String?
  parentIssueId      String?

  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  typeDefinition  WorkItemTypeDefinition? @relation(fields: [projectId, workItemType], references: [projectId, key], onDelete: Restrict)
  assignee        User?                   @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter        User                    @relation("ReportedIssues", fields: [reporterId], references: [id], onDelete: Cascade)
  iteration       Iteration?              @relation(fields: [iterationId], references: [id], onDelete: SetNull)
  area            Area?                   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  stateRecord     State?                  @relation(fields: [stateId], references: [id], onDelete: SetNull)
  parentIssue     Issue?                  @relation("SubIssues", fields: [parentIssueId], references: [id], onDelete: SetNull)
  subIssues       Issue[]                 @relation("SubIssues")
  comments        Comment[]
  labels          IssueLabel[]
  activities      Activity[]
  attachments     Attachment[]
  sourceRelations IssueRelation[]         @relation("SourceIssue")
  targetRelations IssueRelation[]         @relation("TargetIssue")
  fieldValues     WorkItemFieldValue[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@index([iterationId])
  @@index([workItemType])
  @@index([parentIssueId])
  @@index([areaId])
  @@index([stateId])
  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([projectId, iterationId])
  @@index([projectId, areaId])
  @@index([projectId, stateId])
  @@index([projectId, parentIssueId, columnOrder])
  @@index([projectId, status, columnOrder])
  @@index([projectId, status, parentIssueId, columnOrder])
  @@index([projectId, workItemType, status])
  @@index([projectId, updatedAt])
}

model WorkItemFieldValue {
  issueId            String
  fieldDefinitionId  String
  projectId          String
  stringValue        String?
  numberValue        Float?
  booleanValue       Boolean?
  dateValue          DateTime?
  jsonValue          Json?
  updatedAt          DateTime @updatedAt

  issue           Issue                   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldDefinition WorkItemFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@id([issueId, fieldDefinitionId])
  @@index([fieldDefinitionId])
  @@index([projectId])
  @@index([issueId, updatedAt])
}

model IssueRelation {
  id            String   @id @default(cuid())
  sourceIssueId String
  targetIssueId String
  relationType  String
  createdAt     DateTime @default(now())

  sourceIssue Issue @relation("SourceIssue", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssue Issue @relation("TargetIssue", fields: [targetIssueId], references: [id], onDelete: Cascade)

  @@unique([sourceIssueId, targetIssueId, relationType])
  @@index([sourceIssueId])
  @@index([targetIssueId])
  @@index([sourceIssueId, id])
  @@index([targetIssueId, id])
  @@index([sourceIssueId, relationType])
  @@index([targetIssueId, relationType])
  @@index([relationType, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedBy String
  uploadedAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Label {
  id        String @id @default(cuid())
  projectId String
  name      String
  color     String @default("#6b7280")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

model Comment {
  id            String   @id @default(cuid())
  issueId        String
  authorId       String
  content        String
  contentFormat  String   @default("markdown")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  issue     Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions  CommentMention[]
  revisions CommentRevision[]

  @@index([issueId])
  @@index([issueId, id])
  @@index([createdAt])
  @@index([issueId, createdAt])
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  token     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, token])
  @@index([userId])
}

model CommentRevision {
  id              String   @id @default(cuid())
  commentId       String
  editorId        String
  previousContent String
  createdAt       DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  editor  User    @relation("CommentRevisionEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([commentId, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  issueId   String?
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([issueId])
  @@index([issueId, id])
  @@index([createdAt])
}
