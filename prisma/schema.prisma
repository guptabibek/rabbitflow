  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggerUser User?          @relation("AutomationLogTriggerUser", fields: [triggeredBy], references: [id], onDelete: SetNull)
  issue       Issue?         @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([triggeredBy])
  @@index([issueId])
}

model Document {
  id             String                   @id @default(cuid())
  projectId      String
  parentId       String?
  title          String
  content        String                   @default("")
  contentFormat  String                   @default("markdown")
  slug           String?
  icon           String?
  coverImage     String?
  isPublished    Boolean                  @default(false)
  sortOrder      Int                      @default(0)
  createdById    String?
  lastEditedById String?
  searchVector   Unsupported("tsvector")?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       Document?          @relation("DocumentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Document[]         @relation("DocumentHierarchy")
  createdBy    User?              @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy User?              @relation("DocumentEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  revisions    DocumentRevision[]

  @@index([projectId, parentId])
  @@index([projectId, slug])
}

model DocumentRevision {
  id         String   @id @default(cuid())
  documentId String
  editorId   String?
  title      String
  content    String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editor   User?    @relation("DocumentRevisionEditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt(sort: Desc)])
  @@index([editorId])
}

model ApiToken {
