  status      String    @default("on_track")
  progress    Float     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     Objective?  @relation("ObjectiveHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Objective[] @relation("ObjectiveHierarchy")
  owner      User?       @relation("ObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  keyResults KeyResult[]

