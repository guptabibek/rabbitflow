  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("TestPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  testCases TestCase[]
  runs      TestRun[]

  @@index([projectId])
  @@index([createdById])
