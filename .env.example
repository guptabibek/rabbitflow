# =============================================================================
# RabbitFlow — environment configuration
#
# Copy to `.env` for local development:   cp .env.example .env
# Copy to `.env.production` for deploys:  cp .env.example .env.production
#
# NOTE: the Prisma CLI reads `.env`, NOT `.env.local`. Next.js reads both, and
# prefers `.env.local`. If you put DATABASE_URL only in `.env.local`, commands
# like `npx prisma migrate deploy` will fail with a validation error. Keep
# DATABASE_URL in `.env`.
#
# Never commit a populated .env file. Only this example belongs in git.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — the application will not start correctly without these
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://rabbitflow:change-me@localhost:5432/rabbitflow"

# Signing key for session JWTs (HS256). MUST be at least 32 bytes of random data.
# Generate with:  openssl rand -base64 48
# Rotating this invalidates every existing session.
JWT_SECRET=""

# Shared secret for the scheduled-job endpoints (/api/cron,
# /api/recurring-tasks/execute, /api/sla-timers/check-breaches). These endpoints
# fail closed when it is unset, so recurring tasks and SLA breach detection will
# simply not run.
# Generate with:  openssl rand -hex 32
CRON_SECRET=""

# Absolute public URL of the deployment. Used to build deep links in email
# notifications — a wrong value produces unusable links.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Redis — required in any environment where users log in
# -----------------------------------------------------------------------------
# Redis stores MFA challenges and password-reset OTPs. If Redis is configured but
# unavailable, challenged logins and password resets cannot complete, and
# /api/health/ready will report 503 so the instance leaves the rotation.
#
# Provide either REDIS_URL or the discrete REDIS_HOST/REDIS_PORT pair.
REDIS_URL="redis://localhost:6379"

# Password for the Redis instance. Required by docker-compose.production.yml.
# Generate with:  openssl rand -base64 32
REDIS_PASSWORD=""

# Alternative discrete configuration (ignored when REDIS_URL is set).
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# REDIS_USERNAME=""
# REDIS_TLS="false"

# -----------------------------------------------------------------------------
# Database tuning
# -----------------------------------------------------------------------------
# Prisma connection pool size. Raise this if you see P2024 (pool timeout) errors.
# Server-sent-event streams and report aggregations hold connections, so the
# default is easily exhausted under concurrency.
DATABASE_CONNECTION_LIMIT="20"

# -----------------------------------------------------------------------------
# Authentication and session policy
# -----------------------------------------------------------------------------
# Session lifetime. AUTH_SESSION_TTL_SECONDS wins if both are set.
AUTH_SESSION_TTL_DAYS="30"
# AUTH_SESSION_TTL_SECONDS=""

# Self-service registration. Disabled by default: on an internal delivery
# platform, accounts should be provisioned by an administrator. Every
# authenticated account is a foothold, so enable this only deliberately.
ALLOW_SELF_REGISTRATION="false"

# Optional comma-separated allow-list of email domains that may self-register.
# Empty means "any domain" — only meaningful when ALLOW_SELF_REGISTRATION=true.
# ALLOWED_SIGNUP_EMAIL_DOMAINS="yourcompany.com,contractor.example"

# DANGEROUS — development only. When true, an `x-user-id` request header alone
# authenticates a request, with no token verification. Never enable in any
# environment reachable by untrusted traffic.
# ALLOW_HEADER_AUTH="false"

# -----------------------------------------------------------------------------
# Multi-factor authentication
# -----------------------------------------------------------------------------
# Issuer name shown in the user's authenticator app.
MFA_ISSUER="RabbitFlow"

# Require every user to enrol in TOTP MFA at next sign-in. Applies uniformly to
# all roles — administrators are NOT exempt.
MFA_REQUIRE_ENROLLMENT="true"

# Encryption key for TOTP seeds at rest (AES-256-GCM).
# Without it, seeds are stored in the clear: anyone with a database dump could
# mint valid second factors for every enrolled user, without the password and
# without leaving a trace.
# Generate with:  openssl rand -base64 32
# Rotating this makes existing seeds unreadable — affected users must re-enrol.
MFA_ENCRYPTION_KEY=""

# Lifetime of an in-progress MFA challenge, in seconds.
MFA_CHALLENGE_TTL_SECONDS="600"

# Lifetime of a password-reset OTP, in seconds.
PASSWORD_RESET_OTP_TTL_SECONDS="600"

# -----------------------------------------------------------------------------
# SMTP — required for password reset and notification email
# -----------------------------------------------------------------------------
# Without SMTP, /api/auth/password-reset/request returns 503 and users cannot
# recover their accounts themselves.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RabbitFlow <no-reply@example.com>"

# Leave true in production. Setting false disables TLS certificate verification.
SMTP_TLS_REJECT_UNAUTHORIZED="true"

# -----------------------------------------------------------------------------
# First-deploy bootstrap seeding
# -----------------------------------------------------------------------------
# When true, the container entrypoint creates the initial admin user and starter
# project. Set back to false after the first successful deploy.
RUN_BOOTSTRAP_SEED="false"

SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
# Use a strong value and change it immediately after first sign-in.
SEED_ADMIN_PASSWORD=""

# Optional starter-project settings.
# SEED_CREATE_PROJECT="true"
# SEED_PROJECT_KEY="RABBIT"
# SEED_PROJECT_NAME="RabbitFlow"
# SEED_PROJECT_DESCRIPTION=""

# Where uploaded attachments and avatars are stored on disk.
# Deliberately outside public/: files there would be served by the static
# handler with no per-file authorization. Point this at a mounted volume in
# production so uploads survive a container rebuild.
UPLOAD_DIR="./var/uploads"

# -----------------------------------------------------------------------------
# Retention
# -----------------------------------------------------------------------------
# How long append-only tables are kept, in days. Swept by the cron endpoint.
# Without these the tables grow without bound; webhook delivery logs are the
# largest contributor, storing a response body per attempt.
# RETENTION_WEBHOOK_DELIVERY_DAYS="30"
# RETENTION_NOTIFICATION_DAYS="90"          # read notifications only
# RETENTION_AUTOMATION_LOG_DAYS="90"
# RETENTION_ACTIVITY_DAYS="365"             # the work-item audit trail
# RETENTION_EXPIRED_SESSION_DAYS="30"

# -----------------------------------------------------------------------------
# Docker Compose only
# -----------------------------------------------------------------------------
POSTGRES_DB="rabbitflow"
POSTGRES_USER="rabbitflow"
POSTGRES_PASSWORD=""

# Hostname nginx serves. Must match the host used to reach the deployment.
APP_DOMAIN="localhost"

# Host port nginx publishes.
NGINX_PORT="3999"
