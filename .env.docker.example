# =============================================================================
# RabbitFlow — local Docker stack (docker-compose.yml)
#
# `npm run docker:first-deploy` copies this file to `.env.docker` and stops so
# you can fill it in; run it again to build and start. Never commit `.env.docker`.
#
# For production use docker-compose.production.yml with `.env.production`
# (see .env.example and docs/production-upgrade.md).
# =============================================================================

# Required — the stack refuses to start without these.
# Session signing key, at least 32 bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=""
# Shared secret for the scheduled-job endpoints. Generate with:  openssl rand -hex 32
CRON_SECRET=""

# First administrator, created on first start while RUN_BOOTSTRAP_SEED=true.
# Both values are required for the seed to run. The seed never changes the
# password of an administrator that already exists, so set a strong one now,
# and set RUN_BOOTSTRAP_SEED=false after the first successful start.
RUN_BOOTSTRAP_SEED="true"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME="RabbitFlow Admin"
SEED_ADMIN_PASSWORD=""

# Public URL, used for links in emails. Must match how you reach nginx.
APP_URL="http://localhost:4080"
NEXT_PUBLIC_APP_URL="http://localhost:4080"
NGINX_PORT="4080"

# SMTP — needed for password reset and notification email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RabbitFlow <no-reply@example.com>"
